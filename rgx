#!/usr/bin/env python3
"""rgx - expand ripgrep matches in the terminal and scroll through the file."""
import curses
import json
import os
import subprocess
import sys

try:
    from pygments import lex
    from pygments.lexers import get_lexer_for_filename, guess_lexer, TextLexer
    from pygments.token import Token
except ImportError:
    lex = None

WINDOW = 15
MAX_HIGHLIGHT_BYTES = 1_000_000

# Token type -> 256-color (specific before general)
TOKEN_COLORS = [
    ("Comment", 244), ("Keyword", 205), ("Name.Function", 78), ("Name.Class", 78),
    ("Name.Decorator", 179), ("Name.Builtin", 81), ("Name.Tag", 205),
    ("Literal.String", 186), ("Literal.Number", 141), ("Operator.Word", 205),
    ("Generic.Heading", 81), ("Generic.Deleted", 203), ("Generic.Inserted", 78),
]
MATCH_FG, MATCH_BG = 16, 214


def search(args):
    proc = subprocess.run(["rg", "--json", *args], capture_output=True, text=True)
    if proc.returncode not in (0, 1):
        sys.exit(proc.stderr.strip() or "rg error")
    hits = []
    for line in proc.stdout.splitlines():
        ev = json.loads(line)
        if ev["type"] != "match":
            continue
        d = ev["data"]
        path = d["path"].get("text")
        if path is None:
            continue
        text = d["lines"].get("text", "").rstrip("\n")
        raw = text.encode()
        spans = [(len(raw[: m["start"]].decode(errors="replace")),
                  len(raw[: m["end"]].decode(errors="replace"))) for m in d["submatches"]]
        hits.append({"path": path, "line": d["line_number"], "text": text, "spans": spans})
    return hits


def read_lines(path, cache={}):
    if path not in cache:
        try:
            with open(path, "r", errors="replace") as f:
                cache[path] = f.read().splitlines()
        except OSError as e:
            cache[path] = [f"<error: {e}>"]
    return cache[path]


def token_color(tok):
    name = str(tok)[len("Token."):]
    for prefix, color in TOKEN_COLORS:
        if name == prefix or name.startswith(prefix + "."):
            return color
    return -1


def highlighted_lines(path, cache={}):
    """Per line: [(text, fg), ...]"""
    if path in cache:
        return cache[path]
    lines = read_lines(path)
    result = [[(l, -1)] for l in lines]
    if lex is not None:
        try:
            if os.path.getsize(path) <= MAX_HIGHLIGHT_BYTES:
                try:
                    lexer = get_lexer_for_filename(path)
                except Exception:
                    try:
                        lexer = guess_lexer("\n".join(lines))
                    except Exception:
                        lexer = TextLexer()
                result = [[]]
                for tok, val in lex("\n".join(lines), lexer):
                    parts = val.split("\n")
                    for n, part in enumerate(parts):
                        if n:
                            result.append([])
                        if part:
                            result[-1].append((part, token_color(tok)))
                result = (result + [[]] * len(lines))[: len(lines)]
        except OSError:
            pass
    cache[path] = result
    return result


def draw_segments(win, y, x, segments, matches, base_attr, pairs):
    """segments: [(text, fg)], matches: [(start, end)] in characters."""
    cells = []
    for text, fg in segments:
        cells.extend((ch, fg) for ch in text)
    for i, (ch, fg) in enumerate(cells):
        hit = any(a <= i < b for a, b in matches)
        attr = base_attr
        if hit:
            attr = curses.color_pair(pairs(MATCH_FG, MATCH_BG)) | curses.A_BOLD
        elif fg != -1:
            attr |= curses.color_pair(pairs(fg, -1))
        if ch == "\t":
            safe_add(win, y, x, "    ", attr)
            x += 4
        else:
            safe_add(win, y, x, ch, attr)
            x += 1


def safe_add(win, y, x, s, attr=0):
    h, w = win.getmaxyx()
    if 0 <= y < h and x < w:
        try:
            win.addstr(y, x, s[: w - x - 1], attr)
        except curses.error:
            pass


def run(stdscr, hits, pattern_args):
    curses.curs_set(0)
    curses.use_default_colors()
    curses.init_pair(1, curses.COLOR_CYAN, -1)
    curses.init_pair(2, curses.COLOR_YELLOW, -1)
    curses.init_pair(3, curses.COLOR_BLACK, curses.COLOR_YELLOW)
    curses.init_pair(4, curses.COLOR_GREEN, -1)
    pair_cache = {}

    def pairs(fg, bg):
        if (fg, bg) not in pair_cache:
            n = len(pair_cache) + 10
            if n >= curses.COLOR_PAIRS:
                return 0
            curses.init_pair(n, fg, bg)
            pair_cache[(fg, bg)] = n
        return pair_cache[(fg, bg)]

    match_map = {}
    for h_ in hits:
        match_map.setdefault(h_["path"], {})[h_["line"]] = h_["spans"]
    cur = 0
    top = 0
    expanded = False
    win_top = 0  # first visible file line (0-based) in the expanded window

    def window_size(h):
        return max(3, min(WINDOW, h - 4))

    while True:
        h, w = stdscr.getmaxyx()
        ws = window_size(h)
        stdscr.erase()
        safe_add(stdscr, 0, 0, f"rgx {' '.join(pattern_args)}  ({len(hits)} matches)", curses.A_BOLD)
        body = h - 2

        # Layout: one row per match, the expanded match takes ws+1 extra rows
        def height(i):
            return 1 + (ws + 1 if expanded and i == cur else 0)

        if cur < top:
            top = cur
        while True:
            used = sum(height(i) for i in range(top, cur + 1))
            if used <= body or top >= cur:
                break
            top += 1

        y = 1
        i = top
        while i < len(hits) and y < h - 1:
            hit = hits[i]
            sel = i == cur
            head = f"{hit['path']}:{hit['line']}"
            marker = ("▼ " if expanded else "▶ ") if sel else "  "
            attr = curses.A_REVERSE if sel else 0
            safe_add(stdscr, y, 0, marker, attr)
            safe_add(stdscr, y, 2, head, curses.color_pair(1) | attr)
            x = 2 + len(head) + 1
            raw = hit["text"]
            snippet = raw.lstrip()
            off = len(raw) - len(snippet)
            spans = [(a - off, b - off) for a, b in hit["spans"]]
            draw_segments(stdscr, y, x, [(snippet, -1)], spans, attr, pairs)
            y += 1
            if sel and expanded:
                lines = read_lines(hit["path"])
                hl = highlighted_lines(hit["path"])
                mm = match_map.get(hit["path"], {})
                safe_add(stdscr, y, 2, "─" * max(0, w - 4), curses.color_pair(2))
                y += 1
                for k in range(ws):
                    n = win_top + k
                    if n >= len(lines):
                        break
                    num = f"{n + 1:>5} "
                    num_attr = curses.color_pair(2) | curses.A_BOLD if n + 1 in mm else curses.color_pair(4)
                    safe_add(stdscr, y, 2, num, num_attr)
                    draw_segments(stdscr, y, 2 + len(num), hl[n], mm.get(n + 1, []), 0, pairs)
                    y += 1
                y = y + (ws - min(ws, max(0, len(lines) - win_top)))
            i += 1

        if expanded:
            help_ = "↑↓/jk PgUp/PgDn g/G scroll  Space/Esc collapse  e editor  q quit"
        else:
            help_ = "↑↓/jk select  Space expand  e editor  q quit"
        safe_add(stdscr, h - 1, 0, help_, curses.A_DIM)
        stdscr.refresh()

        key = stdscr.getch()
        lines_count = len(read_lines(hits[cur]["path"])) if expanded else 0
        max_top = max(0, lines_count - ws)
        if key in (ord("q"), 3):
            if expanded and key == ord("q"):
                expanded = False
            else:
                return None
        elif key == 27:
            expanded = False
        elif key == ord(" "):
            expanded = not expanded
            if expanded:
                win_top = max(0, hits[cur]["line"] - 1 - ws // 2)
        elif key in (curses.KEY_DOWN, ord("j")):
            if expanded:
                win_top = min(max_top, win_top + 1)
            else:
                cur = min(len(hits) - 1, cur + 1)
        elif key in (curses.KEY_UP, ord("k")):
            if expanded:
                win_top = max(0, win_top - 1)
            else:
                cur = max(0, cur - 1)
        elif key == curses.KEY_NPAGE:
            if expanded:
                win_top = min(max_top, win_top + ws)
            else:
                cur = min(len(hits) - 1, cur + body)
        elif key == curses.KEY_PPAGE:
            if expanded:
                win_top = max(0, win_top - ws)
            else:
                cur = max(0, cur - body)
        elif key in (ord("g"), curses.KEY_HOME):
            if expanded:
                win_top = 0
            else:
                cur = 0
        elif key in (ord("G"), curses.KEY_END):
            if expanded:
                win_top = max_top
            else:
                cur = len(hits) - 1
        elif key == ord("e"):
            line = win_top + 1 if expanded else hits[cur]["line"]
            return hits[cur]["path"], line


def main():
    args = sys.argv[1:]
    if not args or args[0] in ("-h", "--help"):
        print("Usage: rgx [rg options] PATTERN [PATH...]\nExample: rgx -i term src/")
        sys.exit(0 if args else 1)
    hits = search(args)
    if not hits:
        sys.exit("No matches.")
    result = curses.wrapper(run, hits, args)
    if result:
        path, line = result
        editor = os.environ.get("EDITOR", "vim")
        os.execvp(editor, [editor, f"+{line}", path])


if __name__ == "__main__":
    main()
